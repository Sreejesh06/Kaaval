{
  "name": "kaaval-sonar",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "mkdir -p public/mediapipe/wasm && cp -R node_modules/@mediapipe/tasks-vision/wasm/* public/mediapipe/wasm/",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "dev:client": "vite --port 5173",
